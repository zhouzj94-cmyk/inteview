# 密钥模板 —— 复制为 .env 后填入你自己的值（.env 已被 gitignore，不会提交）。
# 该文件同时供 docker compose（变量替换）与 Spring Boot（spring.config.import）读取。
#   cp .env.example .env
#
# 说明：本仓库不包含任何真实密钥。下列均为占位符，请按本地情况填写。

# 阿里云百炼 / DashScope（Qwen）密钥，形如 sk-xxxxxxxx —— 必填，否则 AI 调用不可用
AI_QWEN_API_KEY=sk-your-dashscope-api-key

# Langfuse 可观测性密钥（需与 compose 中 LANGFUSE_INIT_PROJECT_* 一致；不用 Langfuse 可留空）
AI_LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
AI_LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_INIT_USER_PASSWORD=change-me
NEXTAUTH_SECRET=change-me
SALT=change-me

# MySQL / PostgreSQL 本地口令
# 注意：MYSQL_PASSWORD 需与 SPRING_DATASOURCE_PASSWORD 保持一致，后端才能连上库。
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
SPRING_DATASOURCE_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
